{
    "swagger": "2.0",
    "info": {
        "description": "Enterprise Cloud-Native Ticketing Engine Service built with Go, PostgreSQL, Redis, Kafka, and gRPC.",
        "title": "Ticketing Engine API",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {},
