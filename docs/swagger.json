            "get": {
                "description": "Fetches active tickets with Redis Cache-Aside pattern",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Tickets"
                ],
                "summary": "Browse available tickets",
                "responses": {
                    "200": {
