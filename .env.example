# Enterprise Go Ticketing Engine - Environment Configuration Template

# Database Configuration (PostgreSQL 15+)
POSTGRES_USER=root
POSTGRES_PASSWORD=secretpassword
POSTGRES_DB=ticketing_db
POSTGRES_PORT=5432

DB_CONNECTION_STRING="postgres://root:secretpassword@localhost:5432/ticketing_db?sslmode=disable"
JWT_SECRET="your-32-character-secret-key-goes-here"

# --- MinIO / AWS S3 Storage Config ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ticketing-assets
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Configuration & Background Worker Engine
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_ORDER_CREATED=order-created-events
WORKER_COUNT=5
WORKER_BUFFER_SIZE=200
KAFKA_CONSUMER_GROUP_ID=ticketing-order-worker-group

# gRPC Configuration
GRPC_PORT=50051